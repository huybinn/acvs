import requests
from bs4 import BeautifulSoup
import re

def get_m3u8_from_page(url, headers):
    try:
        res = requests.get(url, headers=headers, timeout=10)
        # Tìm link m3u8 trong toàn bộ mã nguồn của trang chi tiết
        match = re.search(r'(https?://[^\s\'"]+\.m3u8[^\s\'"]*)', res.text)
        if match:
            return match.group(1).replace('\\', '') # Xử lý nếu link bị escape
    except:
        pass
    return None

def main():
    base_url = "https://sv2.hoiquan3.live"
    target_url = f"{base_url}/trang-chu"
    
    # Header chuẩn để "giả danh" trình duyệt mobile (giống mẫu bạn đưa)
    user_agent = "Mozilla/5.0 (Linux; Android 6.0; Nexus 5 Build/MRA58N) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/144.0.0.0 Mobile Safari/537.36"
    
    headers = {
        "User-Agent": user_agent,
        "Referer": base_url + "/"
    }

    try:
        response = requests.get(target_url, headers=headers, timeout=15)
        soup = BeautifulSoup(response.text, 'html.parser')
        
        # Tìm tất cả các thẻ <a> dẫn đến bài viết video
        # Thông thường các trang này dùng cấu trúc /video/ hoặc /xem-phim/
        links = soup.find_all('a', href=True)
        
        playlist_content = "#EXTM3U\n"
        added_count = 0
        seen_links = set()

        for item in links:
            href = item['href']
            # Lọc các link có khả năng chứa video
            if "/video/" in href or "post" in href:
                full_link = href if href.startswith('http') else base_url + href
                
                if full_link not in seen_links:
                    title = item.get('title') or item.text.strip() or f"Video {added_count + 1}"
                    
                    # Bước quan trọng: Chui vào trong lấy link m3u8
                    direct_m3u8 = get_m3u8_from_page(full_link, headers)
                    
                    if direct_m3u8:
                        playlist_content += f'#EXTINF:-1 group-title="Hội Quán 3",{title}\n'
                        playlist_content += f'#EXTVLCOPT:http-user-agent={user_agent}\n'
                        playlist_content += f'#EXTVLCOPT:http-referrer={base_url}/\n'
                        playlist_content += f'{direct_m3u8}\n'
                        
                        seen_links.add(full_link)
                        added_count += 1
                        print(f"Đã lấy thành công: {title}")

        if added_count > 0:
            with open("playlist.m3u", "w", encoding="utf-8") as f:
                f.write(playlist_content)
            print(f"Hoàn thành! Đã tạo playlist với {added_count} mục.")
        else:
            print("Không tìm thấy link video nào. Kiểm tra lại cấu trúc web.")

    except Exception as e:
        print(f"Lỗi: {e}")

if __name__ == "__main__":
    main()
